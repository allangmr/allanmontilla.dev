---
const email = 'allangmr10@gmail.com';
const links = [
  { href: `mailto:${email}`, label: email, external: false },
  {
    href: 'https://www.linkedin.com/in/allan-montilla-00a756b3',
    label: 'LinkedIn',
    external: true,
  },
  { href: 'https://github.com/allangmr', label: 'GitHub', external: true },
  { href: 'https://x.com/allan_coding', label: 'X', external: true },
];
---

<footer id="contact" class="scroll-mt-32 border-t border-line bg-void">
  <div class="mx-auto max-w-[1400px] px-5 py-16 sm:px-8 sm:py-20 lg:px-12 lg:py-24">
    <h2 class="font-display text-xs font-bold uppercase tracking-[0.28em] text-accent sm:text-sm">
      Contact
    </h2>
    <p class="mt-8 max-w-[65ch] text-lg leading-relaxed text-snow-muted sm:mt-10 sm:leading-[1.7]">
      Panama · Available for new opportunities
    </p>
    <ul class="mt-9 flex flex-wrap gap-x-6 gap-y-3 text-sm font-medium text-snow" role="list">
      {
        links.map((link) => (
          <li>
            <a
              href={link.href}
              class="inline-flex min-h-11 items-center underline decoration-transparent underline-offset-4 transition-[color,text-decoration-color] duration-200 hover:text-accent hover:decoration-accent"
              {...(link.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
    <p class="mt-12 text-xs tracking-wide text-mist">
      © {new Date().getFullYear()} Allan Montilla
    </p>
  </div>
</footer>
