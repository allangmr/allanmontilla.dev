---
type WorkItem = {
  title: string;
  what: string;
  stack: string[];
  note?: string;
  image?: { src: string; alt: string };
  links?: { label: string; href: string }[];
};

type AlsoItem = {
  title: string;
  detail: string;
  stack?: string;
  status?: string;
};

const projects: WorkItem[] = [
  {
    title: 'LearnCapsule',
    what: 'AI practice companion for English and German. Users save words, phrases, and audio, then turn them into flashcards, pronunciation practice, quizzes, and review capsules.',
    stack: ['TypeScript', 'NestJS', 'Prisma', 'PostgreSQL', 'React', 'React Native', 'Expo'],
    image: {
      src: '/projects/learncapsule.png',
      alt: 'LearnCapsule sign-in screen with capsule illustration',
    },
    links: [
      { label: 'Live demo', href: 'https://learncapsule.softwarepanama.com' },
    ],
  },
  {
    title: 'SCORM / LMS',
    what: 'v1 is a TanStack Start SCORM player (auth, storage, multimedia, progress). v2 is the same product as a monorepo: NestJS API + web + mobile, with parity tests. One product, not two.',
    stack: ['TypeScript', 'TanStack Start', 'NestJS', 'Prisma', 'PostgreSQL', 'Expo'],
    image: {
      src: '/projects/lms-v2.png',
      alt: 'TropicLearn LMS v2 marketing hero and feature grid',
    },
    links: [
      { label: 'Scorm Platform v1', href: 'https://lms.grusetec.com' },
      { label: 'New LMS v2', href: 'https://new-lms.softwarepanama.com' },
    ],
  },
  {
    title: 'HonoClinic',
    what: 'Patient management for clinics — a public TypeScript app.',
    stack: ['TypeScript', 'Hono'],
    image: {
      src: '/projects/honoclinic.png',
      alt: 'HonoClinic CarePulse appointment scheduling landing page',
    },
    links: [
      { label: 'GitHub', href: 'https://github.com/allangmr/HonoClinic' },
      { label: 'Live demo', href: 'https://hono-clinic.vercel.app' },
    ],
  },
  {
    title: 'MrCriptoNite',
    what: 'Next.js site for a crypto creator. Store accepts card or crypto (Shopify API). Airdrop module lets people buy participations with crypto. Also an admin panel and dashboard.',
    stack: ['Next.js', 'TypeScript', 'Shopify'],
    image: {
      src: '/projects/mrcriptonite.png',
      alt: 'MrCriptoNite merch store, Diamond Hands collection',
    },
    links: [
      { label: 'Live', href: 'https://mrcriptonite.com' },
    ],
  },
];

const alsoShipped: AlsoItem[] = [
  {
    title: 'Internal messaging and training',
    detail: 'Videos, images, and multimedia for internal teams.',
    stack: 'Vue · Laravel · PHP · MariaDB',
    status: 'Shipped',
  },
  {
    title: 'Huge',
    detail:
      'Team work (unnamed clients): AEM Classic → EDS migrations, site search, financial calculators, 3D product configurators.',
  },
  {
    title: 'TIVIT LATAM',
    detail:
      'Voting module for Federación Nacional de Cafeteros elections; billing and repair-order software for IDAAN Panama.',
  },
];
---

<section
  id="work"
  class="border-t border-line bg-void-elevated/40"
  aria-labelledby="work-heading"
>
  <div class="mx-auto max-w-[1400px] px-5 py-16 sm:px-8 sm:py-20 lg:px-12 lg:py-24">
    <h2
      id="work-heading"
      class="font-display text-xs font-bold uppercase tracking-[0.28em] text-accent sm:text-sm"
    >
      Projects
    </h2>

    <ul class="mt-12 grid gap-12 sm:grid-cols-2 sm:gap-x-10 sm:gap-y-14 lg:mt-14" role="list">
      {
        projects.map((project) => (
          <li class="max-w-[65ch] border-t border-line pt-6">
            {project.image && (
              <div class="mb-6 overflow-hidden rounded-xl border border-line">
                <img
                  src={project.image.src}
                  alt={project.image.alt}
                  width="1440"
                  height="900"
                  loading="lazy"
                  decoding="async"
                  class="aspect-[16/10] w-full object-cover"
                />
              </div>
            )}
            <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-2">
              <h3 class="font-display text-xl font-semibold tracking-tight text-snow sm:text-2xl">
                {project.title}
              </h3>
              {project.note && (
                <p class="text-[11px] tracking-wide text-mist">{project.note}</p>
              )}
            </div>
            <p class="mt-5 text-[15px] leading-relaxed text-snow-muted sm:mt-6 sm:text-base sm:leading-[1.7]">
              {project.what}
            </p>
            {project.stack.length > 0 && (
              <p
                class="mt-5 text-[12px] leading-relaxed text-mist sm:mt-6"
                aria-label={`${project.title} stack`}
              >
                {project.stack.join(' · ')}
              </p>
            )}
            {project.links && project.links.length > 0 && (
              <ul class="mt-5 flex flex-wrap gap-x-5 gap-y-2 text-sm sm:mt-6" role="list">
                {project.links.map((link) => (
                  <li>
                    <a
                      href={link.href}
                      class="text-accent underline decoration-transparent underline-offset-4 transition-[color,text-decoration-color] duration-200 hover:text-accent-hover hover:decoration-accent-hover"
                      target="_blank"
                      rel="noopener noreferrer"
                    >
                      {link.label}
                    </a>
                  </li>
                ))}
              </ul>
            )}
          </li>
        ))
      }
    </ul>

    <div class="mt-14 max-w-[65ch] border-t border-line pt-8 sm:mt-16 sm:pt-9">
      <h3
        id="also-shipped-heading"
        class="font-display text-[11px] font-bold uppercase tracking-[0.24em] text-mist sm:text-xs"
      >
        Also shipped
      </h3>
      <ul class="mt-5 space-y-3 sm:mt-6 sm:space-y-3.5" role="list" aria-labelledby="also-shipped-heading">
        {
          alsoShipped.map((item) => (
            <li class="text-[14px] leading-snug text-fog sm:text-[15px] sm:leading-snug">
              <span class="font-medium text-snow">{item.title}</span>
              <span class="text-mist" aria-hidden="true">
                {' '}
                —{' '}
              </span>
              <span>{item.detail}</span>
              {item.stack && (
                <>
                  <span class="text-mist" aria-hidden="true">
                    {' '}
                    ·{' '}
                  </span>
                  <span class="text-mist">{item.stack}</span>
                </>
              )}
              {item.status && (
                <>
                  <span class="text-mist" aria-hidden="true">
                    {' '}
                    ·{' '}
                  </span>
                  <span class="text-mist">{item.status}</span>
                </>
              )}
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>
