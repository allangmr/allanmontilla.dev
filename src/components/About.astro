      <p class="mt-10 text-base leading-relaxed text-snow sm:mt-12 sm:text-lg sm:leading-[1.7]">
        Hi, I’m Allan. Nice to meet you.
      </p>

      <ul class="mt-12 space-y-12 sm:mt-14 sm:space-y-14" role="list">
        {
          entries.map((entry) => (
            <li class="border-t border-line pt-6 sm:pt-7">
              <div class="flex flex-wrap items-baseline gap-x-2 gap-y-1">
                <span class="text-[11px] font-semibold uppercase tracking-[0.22em] text-accent">
                  {entry.label}
                </span>
                <span class="text-mist" aria-hidden="true">
                  ·
                </span>
                <span class="font-display text-lg font-semibold tracking-tight text-snow sm:text-xl">
                  {entry.org}
                </span>
              </div>

              {(entry.role || entry.years) && (
                <p class="mt-2 flex flex-wrap items-baseline gap-x-2 gap-y-1 text-[15px] text-snow sm:text-base">
                  {entry.role && <span>{entry.role}</span>}
                  {entry.role && entry.years && (
                    <span class="text-mist" aria-hidden="true">
                      ·
                    </span>
                  )}
                  {entry.years && <span class="text-sm text-mist sm:text-[15px]">{entry.years}</span>}
                </p>
              )}

