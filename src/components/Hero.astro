---
const chips = [
  { label: 'TypeScript', icon: 'ts' },
  { label: 'NestJS', icon: 'nest' },
];
---

<section
  class="relative isolate min-h-[100svh] overflow-hidden bg-void"
  aria-labelledby="hero-heading"
>
  <!-- Full-bleed video / poster layer — drop /hero.mp4 when ready -->
  <div class="pointer-events-none absolute inset-0 z-0" aria-hidden="true">
    <div
      class="absolute inset-0 bg-void bg-cover bg-center"
      style="background-image: url('/scene/hero-poster.jpg')"
    >
      <video
        class="hero-fade h-full w-full object-cover"
        autoplay
        muted
        loop
        playsinline
        preload="metadata"
        poster="/scene/hero-poster.jpg"
      >
        <source src="/hero.mp4" type="video/mp4" />
      </video>
    </div>

    <!-- Left-to-right veil: darker ~40% for headline, clear on the right -->
    <div
      class="absolute inset-0 bg-gradient-to-r from-void from-[8%] via-void/80 via-[32%] to-transparent to-[62%]"
    >
    </div>
    <div class="absolute inset-0 bg-gradient-to-t from-void/75 via-transparent via-45% to-void/40"></div>
    <div class="absolute inset-x-0 bottom-0 h-28 bg-gradient-to-t from-void to-transparent sm:h-36">
    </div>

    <aside
      class="absolute bottom-[22%] right-5 hidden max-w-[200px] text-left lg:right-10 lg:block xl:bottom-[24%] xl:right-12"
    >
      <p class="text-xs font-semibold uppercase tracking-[0.28em] text-accent">Panama Canal</p>
      <span class="mt-2.5 block h-px w-12 bg-accent" aria-hidden="true"></span>
      <p class="mt-3 text-[13px] leading-relaxed text-snow/85">
        A symbol of connection, engineering and human ambition.
      </p>
    </aside>
  </div>

  <div
    class="relative z-10 mx-auto flex min-h-[100svh] max-w-[1440px] flex-col px-5 pb-8 pt-24 sm:px-8 sm:pb-10 sm:pt-28 lg:px-12 lg:pt-32"
  >
    <div class="flex flex-1 flex-col justify-center lg:max-w-[50%] lg:justify-start lg:pt-4 xl:max-w-[46%]">
      <p class="hero-rise text-xs font-semibold uppercase tracking-[0.32em] text-accent sm:text-[13px]">
        Engineered for learning
      </p>

      <h1
        id="hero-heading"
        class="hero-rise mt-7 font-display text-[clamp(2.75rem,9vw,5.75rem)] font-bold uppercase leading-[1.02] tracking-[-0.02em] [animation-delay:80ms]"
      >
        <span class="block whitespace-nowrap text-snow">Building</span>
        <span class="block whitespace-nowrap text-mist">Products</span>
        <span class="block whitespace-nowrap text-snow">That Teach</span>
      </h1>

      <p
        class="hero-rise mt-8 max-w-[30rem] text-[15px] leading-relaxed text-snow-muted [animation-delay:140ms] sm:mt-9 sm:text-base sm:leading-[1.7]"
      >
        Full-stack TypeScript engineer in Panama. I ship LMS platforms, SCORM players, and AI
        language practice — APIs, web, and mobile. Open to remote US/EU roles.
      </p>

      <a
        href="#work"
        class="hero-rise group mt-9 inline-flex w-fit items-center gap-3 text-xs font-semibold uppercase tracking-[0.28em] text-accent transition-colors [animation-delay:200ms] hover:text-accent-hover sm:mt-10"
      >
        View work
        <span
          class="inline-block text-base leading-none transition-transform duration-300 group-hover:translate-x-1"
          aria-hidden="true">→</span
        >
      </a>

      <ul
        class="mt-7 flex flex-wrap items-center gap-x-4 gap-y-2 text-[11px] font-medium uppercase tracking-[0.22em] text-snow/80 sm:mt-8"
        role="list"
        aria-label="Core tools"
      >
        {
          chips.map((chip, i) => (
            <li class="flex items-center gap-4">
              {i > 0 && <span class="h-3 w-px bg-line-strong" aria-hidden="true" />}
              <span class="inline-flex items-center gap-2">
                {chip.icon === 'ts' && (
                  <svg class="h-3.5 w-3.5 text-snow/60" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                    <path d="M2 3h12v10H2z" stroke="currentColor" stroke-width="1.2" />
                    <path d="M5 8h6M8 8v4" stroke="currentColor" stroke-width="1.2" />
                  </svg>
                )}
                {chip.icon === 'nest' && (
                  <svg class="h-3.5 w-3.5 text-snow/60" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                    <path
                      d="M8 2 13 5.2v5.6L8 14 3 10.8V5.2L8 2Z"
                      stroke="currentColor"
                      stroke-width="1.2"
                    />
                  </svg>
                )}
                {chip.label}
              </span>
            </li>
          ))
        }
      </ul>

      <aside class="mt-10 max-w-xs lg:hidden">
        <p class="text-xs font-semibold uppercase tracking-[0.28em] text-accent">Panama Canal</p>
        <span class="mt-2 block h-px w-12 bg-accent" aria-hidden="true"></span>
        <p class="mt-2.5 text-sm leading-relaxed text-fog">
          A symbol of connection, engineering and human ambition.
        </p>
      </aside>
    </div>

    <div class="min-h-[28vh] flex-1 sm:min-h-0 lg:flex-none" aria-hidden="true"></div>

    <div class="relative z-10 mt-auto flex flex-col gap-3 pt-4 sm:flex-row sm:items-end sm:justify-between sm:gap-10">
      <div class="max-w-md">
        <p class="font-script text-[1.4rem] leading-snug text-snow sm:text-[1.7rem]">
          Let's build something that gets noticed.
        </p>
        <p class="mt-3 text-[11px] font-semibold uppercase tracking-[0.28em] text-accent">
          Available for new opportunities
        </p>
      </div>

      <p class="max-w-xs text-[11px] leading-relaxed tracking-wide text-mist sm:text-right sm:text-xs">
        Cinematic Panama Canal hero — video landing soon.
      </p>
    </div>
  </div>
</section>
