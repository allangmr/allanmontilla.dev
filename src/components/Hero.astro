---
const chips = ['TypeScript', 'React', 'Next.js'];
---

<section
  class="relative isolate min-h-[100svh] overflow-hidden bg-void"
  aria-labelledby="hero-heading"
>
  <!-- Full-bleed video / poster layer -->
  <div class="pointer-events-none absolute inset-0 z-0" aria-hidden="true">
    <div
      class="absolute inset-0 bg-void bg-cover bg-center"
      style="background-image: url('/scene/hero-poster.jpg')"
    >
      <video
        class="hero-fade h-full w-full object-cover"
        autoplay
        muted
        loop
        playsinline
        preload="metadata"
        poster="/scene/hero-poster.jpg"
      >
        <source src="/hero.mp4" type="video/mp4" />
      </video>
    </div>

    <!-- Left-to-right veil: darker for headline, clear on the right -->
    <div
      class="absolute inset-0 bg-gradient-to-r from-void from-[8%] via-void/80 via-[32%] to-transparent to-[62%]"
    >
    </div>
    <div class="absolute inset-0 bg-gradient-to-t from-void/75 via-transparent via-45% to-void/40"></div>
    <div class="absolute inset-x-0 bottom-0 h-28 bg-gradient-to-t from-void to-transparent sm:h-36">
    </div>
  </div>

  <!-- Canal caption lives above video + veils so it never washes into footage -->
  <aside
    class="pointer-events-none absolute bottom-[22%] right-5 z-20 hidden max-w-[220px] text-left lg:right-10 lg:block xl:bottom-[24%] xl:right-12"
  >
    <div class="flex items-start gap-2">
      <svg
        class="mt-0.5 h-3.5 w-3.5 shrink-0 text-accent"
        viewBox="0 0 16 16"
        fill="none"
        aria-hidden="true"
      >
        <path
          d="M8 1.5c-2.5 0-4.5 2-4.5 4.5 0 3.4 4.5 8.5 4.5 8.5s4.5-5.1 4.5-8.5c0-2.5-2-4.5-4.5-4.5Z"
          stroke="currentColor"
          stroke-width="1.2"
        ></path>
        <circle cx="8" cy="6" r="1.5" stroke="currentColor" stroke-width="1.2"></circle>
      </svg>
      <div>
        <p class="text-xs font-semibold uppercase tracking-[0.28em] text-accent">Panama Canal</p>
        <span class="mt-2.5 block h-px w-12 bg-accent" aria-hidden="true"></span>
        <p class="mt-3 text-[13px] leading-relaxed text-snow/90">
          A symbol of connection, engineering and human ambition.
        </p>
      </div>
    </div>
  </aside>

  <div
    class="relative z-10 mx-auto flex min-h-[100svh] max-w-[1440px] flex-col px-5 pb-12 pt-28 sm:px-8 sm:pb-14 sm:pt-32 lg:px-12 lg:pb-16 lg:pt-36"
  >
    <div class="flex flex-1 flex-col justify-center pb-6 lg:max-w-[50%] lg:justify-start lg:pb-8 lg:pt-2 xl:max-w-[46%]">
      <p class="hero-rise text-xs font-semibold uppercase tracking-[0.32em] text-accent sm:text-[13px]">
        Web developer &amp; software engineer.
      </p>

      <h1
        id="hero-heading"
        class="hero-rise mt-8 font-display text-[clamp(2.5rem,7.5vw,4.75rem)] font-bold uppercase leading-[0.98] tracking-[-0.02em] [animation-delay:80ms]"
      >
        <span class="block whitespace-nowrap text-snow">Building</span>
        <span class="block whitespace-nowrap text-mist">Interfaces</span>
        <span class="block whitespace-nowrap text-snow">That Last</span>
      </h1>

      <span class="hero-rise mt-7 block h-px w-14 bg-accent [animation-delay:110ms]" aria-hidden="true"
      ></span>

      <p
        class="hero-rise mt-7 max-w-[36rem] text-[15px] leading-relaxed text-snow-muted [animation-delay:140ms] sm:mt-8 sm:text-base sm:leading-[1.7]"
      >
        Hi, I’m Allan. I build product UIs that survive real users — React, Next.js, and TypeScript,
        from Panama. Open to remote US/EU roles.
      </p>

      <a
        href="#work"
        class="hero-rise group mt-9 inline-flex min-h-11 w-fit items-center gap-3 text-xs font-semibold uppercase tracking-[0.28em] text-accent transition-colors duration-200 [animation-delay:200ms] hover:text-accent-hover sm:mt-10"
      >
        View work
        <span
          class="inline-block text-base leading-none transition-transform duration-300 group-hover:translate-x-1"
          aria-hidden="true">→</span
        >
      </a>

      <ul
        class="mt-8 flex flex-wrap items-center gap-x-4 gap-y-2 text-[11px] font-medium uppercase tracking-[0.22em] text-snow/80 sm:mt-9"
        role="list"
        aria-label="Core tools"
      >
        {
          chips.map((chip, i) => (
            <li class="flex items-center gap-4">
              {i > 0 && <span class="h-3 w-px bg-line-strong" aria-hidden="true" />}
              <span>{chip}</span>
            </li>
          ))
        }
      </ul>

      <aside class="mt-10 max-w-xs lg:hidden">
        <p class="text-xs font-semibold uppercase tracking-[0.28em] text-accent">Panama Canal</p>
        <span class="mt-2.5 block h-px w-12 bg-accent" aria-hidden="true"></span>
        <p class="mt-3 text-sm leading-relaxed text-fog">
          A symbol of connection, engineering and human ambition.
        </p>
      </aside>
    </div>

    <div class="min-h-[12vh] flex-1 sm:min-h-[8vh] lg:min-h-0 lg:flex-none" aria-hidden="true"></div>

    <div class="relative z-10 mt-auto flex flex-col gap-6 pt-6 sm:flex-row sm:items-end sm:justify-between sm:gap-10 sm:pt-8">
      <div class="max-w-md">
        <p class="font-script text-[1.4rem] leading-snug text-snow sm:text-[1.7rem]">
          Let's build something that gets noticed.
        </p>
        <p class="mt-3 text-[11px] font-semibold uppercase tracking-[0.28em] text-accent">
          Available for new opportunities
        </p>
      </div>

      <a
        href="https://github.com/allangmr"
        target="_blank"
        rel="noopener noreferrer"
        class="group flex max-w-sm items-start gap-4 border border-snow/25 px-4 py-4 transition-colors duration-200 hover:border-accent sm:px-5 sm:py-5"
      >
        <svg
          class="mt-0.5 h-5 w-5 shrink-0 text-accent"
          viewBox="0 0 16 16"
          fill="none"
          aria-hidden="true"
        >
          <path
            d="M4.5 5.5 8 3.5l3.5 2v5L8 12.5 4.5 10.5v-5Z"
            stroke="currentColor"
            stroke-width="1.2"
          ></path>
          <path d="M8 3.5v9M4.5 5.5 8 7.5l3.5-2" stroke="currentColor" stroke-width="1.2"></path>
        </svg>
        <span class="min-w-0">
          <span
            class="block text-[11px] font-semibold uppercase tracking-[0.22em] text-snow transition-colors duration-200 group-hover:text-accent"
          >
            Built from Panama
          </span>
          <span class="mt-2 block text-[12px] leading-relaxed text-snow-muted sm:text-[13px]">
            I design and ship web products from Panama — interfaces first, then the APIs and mobile
            around them.
          </span>
        </span>
      </a>
    </div>
  </div>
</section>
