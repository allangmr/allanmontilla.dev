---
const chips = [
  { label: 'TypeScript', icon: 'ts' },
  { label: 'NestJS', icon: 'nest' },
  { label: 'Three.js', icon: 'three' },
];
---

<section
  class="relative isolate min-h-[100svh] overflow-hidden bg-void"
  aria-labelledby="hero-heading"
>
  <!-- Scene layer -->
  <div class="pointer-events-none absolute inset-0 z-0" aria-hidden="true">
    <div
      id="canal-scene-root"
      class="absolute inset-x-0 top-[38%] h-[52%] sm:inset-y-0 sm:left-[28%] sm:right-0 sm:top-0 sm:h-full lg:left-[32%]"
    >
      <canvas id="canal-canvas" class="hero-fade h-full w-full opacity-95 [animation-delay:280ms]"
      ></canvas>
      <div class="absolute inset-0 bg-gradient-to-r from-void via-void/40 to-transparent sm:via-void/20">
      </div>
      <div class="absolute inset-0 bg-gradient-to-t from-void via-transparent to-void/70"></div>
      <div
        class="absolute inset-0 bg-gradient-to-b from-transparent via-transparent to-void/90 sm:to-void/60"
      >
      </div>
    </div>

    <!-- Scene caption (desktop) -->
    <aside
      class="absolute bottom-[28%] right-6 hidden max-w-[200px] text-right lg:right-10 lg:block xl:bottom-[30%]"
    >
      <p class="text-[10px] font-semibold uppercase tracking-[0.28em] text-accent">Panama Canal</p>
      <p class="mt-2 text-xs leading-relaxed text-snow-muted">
        A symbol of connection, engineering and human ambition.
      </p>
      <svg class="ml-auto mt-3 h-4 w-4 text-accent" viewBox="0 0 16 16" fill="none" aria-hidden="true">
        <path
          d="M8 1.5C5.5 1.5 3.5 3.5 3.5 6c0 3.2 4.5 8 4.5 8s4.5-4.8 4.5-8c0-2.5-2-4.5-4.5-4.5Z"
          stroke="currentColor"
          stroke-width="1.2"></path>
        <circle cx="8" cy="6" r="1.4" fill="currentColor"></circle>
      </svg>
    </aside>
  </div>

  <div
    class="relative z-10 mx-auto flex min-h-[100svh] max-w-[1400px] flex-col px-5 pb-8 pt-24 sm:px-8 sm:pb-10 sm:pt-28 lg:px-10"
  >
    <div class="flex flex-1 flex-col justify-start lg:max-w-[46%] xl:max-w-[42%]">
      <p class="hero-rise text-[11px] font-semibold uppercase tracking-[0.32em] text-accent sm:text-xs">
        Engineered for learning.
      </p>

      <h1
        id="hero-heading"
        class="hero-rise mt-5 font-display text-[clamp(3.25rem,11vw,6.75rem)] font-bold uppercase leading-[0.88] tracking-[-0.02em] [animation-delay:90ms]"
      >
        <span class="block text-snow">Building</span>
        <span class="block text-mist">Products</span>
        <span class="block text-snow">That Teach</span>
      </h1>

      <p
        class="hero-rise mt-6 max-w-md text-sm leading-relaxed text-snow-muted [animation-delay:160ms] sm:text-base"
      >
        Full-stack TypeScript engineer in Panama. I ship LMS platforms, SCORM players, and AI
        language practice — APIs, web, and mobile. Open to remote US/EU roles.
      </p>

      <a
        href="#work"
        class="hero-rise group mt-8 inline-flex w-fit items-center gap-3 text-xs font-semibold uppercase tracking-[0.28em] text-accent transition-colors [animation-delay:240ms] hover:text-accent-hover"
      >
        View work
        <span
          class="inline-block translate-y-px transition-transform duration-300 group-hover:translate-x-1"
          aria-hidden="true">→</span
        >
      </a>

      <ul
        class="mt-6 flex flex-wrap items-center gap-x-3 gap-y-2 text-[10px] font-medium uppercase tracking-[0.22em] text-snow/85 sm:text-[11px]"
        role="list"
        aria-label="Core tools"
      >
        {
          chips.map((chip, i) => (
            <li class="flex items-center gap-3">
              {i > 0 && <span class="h-3 w-px bg-line-strong" aria-hidden="true" />}
              <span class="inline-flex items-center gap-2">
                {chip.icon === 'ts' && (
                  <svg class="h-3.5 w-3.5 text-snow/70" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                    <path d="M2 3h12v10H2z" stroke="currentColor" stroke-width="1.2" />
                    <path d="M5 8h6M8 8v4" stroke="currentColor" stroke-width="1.2" />
                  </svg>
                )}
                {chip.icon === 'nest' && (
                  <svg class="h-3.5 w-3.5 text-snow/70" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                    <path d="M8 2 13 5.2v5.6L8 14 3 10.8V5.2L8 2Z" stroke="currentColor" stroke-width="1.2" />
                  </svg>
                )}
                {chip.icon === 'three' && (
                  <svg class="h-3.5 w-3.5 text-snow/70" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                    <path d="M8 2 14 5.5v5L8 14 2 10.5v-5L8 2Z" stroke="currentColor" stroke-width="1.2" />
                    <path d="M8 2v12M2 5.5l6 3.5 6-3.5" stroke="currentColor" stroke-width="1" opacity="0.7" />
                  </svg>
                )}
                {chip.label}
              </span>
            </li>
          ))
        }
      </ul>

      <!-- Mobile scene caption -->
      <aside class="mt-8 max-w-xs lg:hidden">
        <p class="text-[10px] font-semibold uppercase tracking-[0.28em] text-accent">Panama Canal</p>
        <p class="mt-2 text-xs leading-relaxed text-fog">
          A symbol of connection, engineering and human ambition.
        </p>
      </aside>
    </div>

    <!-- Spacer for mobile canvas area -->
    <div class="min-h-[38vh] flex-1 sm:min-h-0" aria-hidden="true"></div>

    <div
      class="relative z-10 mt-auto flex flex-col gap-6 pt-4 sm:flex-row sm:items-end sm:justify-between sm:gap-8"
    >
      <div>
        <p class="font-script text-xl text-snow sm:text-2xl">
          Let's build something that gets noticed.
        </p>
        <p class="mt-2 text-[10px] font-semibold uppercase tracking-[0.28em] text-accent sm:text-[11px]">
          Available for new opportunities
        </p>
      </div>

      <article class="max-w-sm border border-line-strong bg-void/40 p-4 backdrop-blur-[2px] sm:p-5">
        <div class="flex items-start gap-3">
          <svg
            class="mt-0.5 h-5 w-5 shrink-0 text-snow/80"
            viewBox="0 0 20 20"
            fill="none"
            aria-hidden="true"
          >
            <path
              d="M10 2.5 17 6.5v7l-7 4-7-4v-7l7-4Z"
              stroke="currentColor"
              stroke-width="1.2"></path>
            <path d="M10 2.5v15M3 6.5l7 4 7-4" stroke="currentColor" stroke-width="1" opacity="0.7"
            ></path>
          </svg>
          <div>
            <h2 class="text-[11px] font-semibold uppercase tracking-[0.22em] text-accent">
              Interactive by design
            </h2>
            <p class="mt-2 text-xs leading-relaxed text-snow-muted">
              A procedural Three.js canal: cargo ship, lock walls, dark water, and orange topo lines
              — a Panama signature baked into the hero.
            </p>
            <a
              href="https://github.com/allangmr/allanmontilla.dev"
              class="mt-3 inline-flex items-center gap-2 text-[10px] font-semibold uppercase tracking-[0.24em] text-accent transition-colors hover:text-accent-hover"
              target="_blank"
              rel="noopener noreferrer"
            >
              See the code
              <span aria-hidden="true">→</span>
            </a>
          </div>
        </div>
      </article>
    </div>
  </div>
</section>

<script>
  const boot = async () => {
    const canvas = document.getElementById('canal-canvas');
    if (!(canvas instanceof HTMLCanvasElement)) return;
    const { mountCanalScene } = await import('../scripts/canal-scene');
    const handle = mountCanalScene(canvas);
    window.addEventListener(
      'astro:before-swap',
      () => {
        handle.destroy();
      },
      { once: true },
    );
  };

  const schedule = () => {
    if ('requestIdleCallback' in window) {
      requestIdleCallback(() => {
        void boot();
      }, { timeout: 1200 });
    } else {
      setTimeout(() => {
        void boot();
      }, 200);
    }
  };

  if (document.readyState === 'complete') schedule();
  else window.addEventListener('load', schedule, { once: true });
</script>
