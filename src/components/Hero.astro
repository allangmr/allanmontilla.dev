---
const chips = ['TypeScript', 'React', 'Next.js'];
---

<section
  class="hero relative isolate min-h-[100svh] overflow-hidden bg-void"
  aria-labelledby="hero-heading"
>
  <!-- Full-bleed poster; mp4 loads only on desktop without reduced motion -->
  <div class="pointer-events-none absolute inset-0 z-0" aria-hidden="true">
    <div
      class="absolute inset-0 bg-void bg-cover bg-center"
      style="background-image: url('/scene/hero-poster.jpg')"
    >
      <video
        class="hero-video h-full w-full object-cover"
        muted
        loop
        playsinline
        preload="none"
        poster="/scene/hero-poster.jpg"
        data-src="/hero.mp4"
      >
      </video>
    </div>

    <div
      class="absolute inset-0 bg-gradient-to-r from-void from-[8%] via-void/80 via-[32%] to-transparent to-[62%]"
    >
    </div>
    <div class="absolute inset-0 bg-gradient-to-t from-void/75 via-transparent via-45% to-void/40"></div>
    <div class="absolute inset-x-0 bottom-0 h-28 bg-gradient-to-t from-void to-transparent sm:h-36">
    </div>
  </div>

  <!-- Canal caption above video + veils -->
  <aside class="hero-canal pointer-events-none absolute z-20 hidden text-left lg:block">
    <div class="flex items-start gap-2">
      <svg
        class="mt-0.5 h-3.5 w-3.5 shrink-0 text-accent"
        viewBox="0 0 16 16"
        fill="none"
        aria-hidden="true"
      >
        <path
          d="M8 1.5c-2.5 0-4.5 2-4.5 4.5 0 3.4 4.5 8.5 4.5 8.5s4.5-5.1 4.5-8.5c0-2.5-2-4.5-4.5-4.5Z"
          stroke="currentColor"
          stroke-width="1.2"
        ></path>
        <circle cx="8" cy="6" r="1.5" stroke="currentColor" stroke-width="1.2"></circle>
      </svg>
      <div>
        <p class="text-xs font-semibold uppercase tracking-[0.28em] text-accent">Panama Canal</p>
        <span class="mt-2.5 block h-px w-12 bg-accent" aria-hidden="true"></span>
        <p class="mt-3 text-[13px] leading-relaxed text-snow/90">
          A symbol of connection, engineering and human ambition.
        </p>
      </div>
    </div>
  </aside>

  <div class="hero-shell relative z-10 mx-auto flex min-h-[100svh] max-w-[1440px] flex-col">
    <div class="hero-copy lg:max-w-[50%] xl:max-w-[46%]">
      <h1
        id="hero-heading"
        class="hero-rise hero-title font-display font-bold tracking-[-0.03em] text-snow"
      >
        Allan Montilla
      </h1>

      <p class="hero-rise hero-role mt-3 text-lg font-medium leading-snug text-snow sm:mt-4 sm:text-xl [animation-delay:60ms]">
        Senior Frontend Engineer at Huge
      </p>

      <p class="hero-rise hero-place mt-2 text-[15px] text-fog sm:text-base [animation-delay:90ms]">
        Panama · open to remote US/EU
      </p>

      <p
        class="hero-rise hero-slogan mt-7 font-display font-bold leading-tight tracking-[-0.02em] text-mist [animation-delay:120ms] sm:mt-8"
      >
        Building interfaces that last
      </p>

      <span class="hero-rise hero-rule mt-6 block h-px w-14 bg-accent [animation-delay:150ms]" aria-hidden="true"
      ></span>

      <a
        href="#work"
        class="hero-rise hero-cta group mt-8 inline-flex min-h-11 w-fit items-center gap-3 text-xs font-semibold uppercase tracking-[0.28em] text-accent transition-colors duration-200 [animation-delay:200ms] hover:text-accent-hover"
      >
        View work
        <span
          class="inline-block text-base leading-none transition-transform duration-300 group-hover:translate-x-1"
          aria-hidden="true">→</span
        >
      </a>

      <ul
        class="hero-chips mt-7 flex flex-wrap items-center gap-x-4 gap-y-2 text-[11px] font-medium uppercase tracking-[0.22em] text-snow/80"
        role="list"
        aria-label="Core tools"
      >
        {
          chips.map((chip, i) => (
            <li class="flex items-center gap-4">
              {i > 0 && <span class="h-3 w-px bg-line-strong" aria-hidden="true" />}
              <span>{chip}</span>
            </li>
          ))
        }
      </ul>

      <aside class="hero-canal-mobile mt-8 max-w-xs lg:hidden">
        <p class="text-xs font-semibold uppercase tracking-[0.28em] text-accent">Panama Canal</p>
        <span class="mt-2.5 block h-px w-12 bg-accent" aria-hidden="true"></span>
        <p class="mt-3 text-sm leading-relaxed text-fog">
          A symbol of connection, engineering and human ambition.
        </p>
      </aside>
    </div>

    <div class="hero-footer relative z-10 mt-auto flex flex-col gap-5 sm:flex-row sm:items-end sm:justify-between sm:gap-8">
      <div class="max-w-md">
        <p class="font-script text-[1.35rem] leading-snug text-snow sm:text-[1.6rem]">
          Let's build something that gets noticed.
        </p>
        <p class="mt-2.5 text-[11px] font-semibold uppercase tracking-[0.28em] text-accent">
          Available for new opportunities
        </p>
      </div>

      <a
        href="https://github.com/allangmr"
        target="_blank"
        rel="noopener noreferrer"
        class="hero-panama-card group flex max-w-sm items-start gap-4 border border-snow/25 px-4 py-4 transition-colors duration-200 hover:border-accent sm:px-5 sm:py-4"
      >
        <svg
          class="mt-0.5 h-5 w-5 shrink-0 text-accent"
          viewBox="0 0 16 16"
          fill="none"
          aria-hidden="true"
        >
          <path
            d="M4.5 5.5 8 3.5l3.5 2v5L8 12.5 4.5 10.5v-5Z"
            stroke="currentColor"
            stroke-width="1.2"
          ></path>
          <path d="M8 3.5v9M4.5 5.5 8 7.5l3.5-2" stroke="currentColor" stroke-width="1.2"></path>
        </svg>
        <span class="min-w-0">
          <span
            class="block text-[11px] font-semibold uppercase tracking-[0.22em] text-snow transition-colors duration-200 group-hover:text-accent"
          >
            Built from Panama
          </span>
          <span class="hero-panama-card__body mt-2 block text-[12px] leading-relaxed text-snow-muted sm:text-[13px]">
            I design and ship web products from Panama — interfaces first, then the APIs and mobile
            around them.
          </span>
        </span>
      </a>
    </div>
  </div>
</section>

<script>
  const video = document.querySelector<HTMLVideoElement>('.hero-video');
  if (video) {
    const src = video.dataset.src;
    const desktop = window.matchMedia('(min-width: 768px)');
    const motion = window.matchMedia('(prefers-reduced-motion: reduce)');

    const allowed = () => desktop.matches && !motion.matches;

    const unload = () => {
      video.pause();
      video.removeAttribute('src');
      video.querySelectorAll('source').forEach((el) => el.remove());
      video.load();
    };

    const load = () => {
      if (!src) return;
      if (!video.querySelector('source')) {
        const source = document.createElement('source');
        source.src = src;
        source.type = 'video/mp4';
        video.appendChild(source);
        video.load();
      }
      void video.play().catch(() => {});
    };

    const sync = () => {
      if (allowed()) load();
      else unload();
    };

    sync();
    desktop.addEventListener('change', sync);
    motion.addEventListener('change', sync);
  }
</script>
