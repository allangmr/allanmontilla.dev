---
const links = [
  { href: '#about', label: 'About' },
  { href: '#work', label: 'Work' },
  { href: '#contact', label: 'Contact' },
];
---

<header class="border-b border-line/80 bg-paper/80 backdrop-blur-sm">
  <div class="mx-auto flex max-w-3xl items-center justify-between gap-6 px-6 py-5 sm:px-8">
    <a href="/" class="text-base font-semibold tracking-tight text-ink" aria-current="page">
      Allan Montilla
    </a>
    <nav aria-label="Primary">
      <ul class="flex items-center gap-5 text-sm text-ink-muted sm:gap-7">
        {
          links.map((link) => (
            <li>
              <a href={link.href} class="transition-colors hover:text-ink">
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>
