---
const links = [
  { href: '#about', label: 'About' },
  { href: '#work', label: 'Projects' },
  { href: '#contact', label: 'Contact' },
];
---

<header class="fixed inset-x-0 top-0 z-40 bg-gradient-to-b from-void via-void/80 to-transparent">
  <div
    class="mx-auto flex max-w-[1400px] items-center justify-between gap-6 px-5 py-5 sm:px-8 lg:px-10"
  >
    <a
      href="/"
      class="group inline-flex items-center gap-3 text-snow"
      aria-current="page"
      aria-label="Allan Montilla home"
    >
      <img
        src="/logo-ia.svg"
        alt=""
        width="104"
        height="72"
        class="h-7 w-auto sm:h-8"
        decoding="async"
      />
      <span class="sr-only">Allan Montilla</span>
    </a>

    <div class="flex items-center gap-5 sm:gap-7">
      <nav aria-label="Primary">
        <ul
          class="flex items-center gap-1 text-[11px] font-medium uppercase tracking-[0.22em] text-snow-muted sm:gap-2 sm:text-xs"
        >
          {
            links.map((link, i) => (
              <li class="flex items-center gap-1 sm:gap-2">
                {i > 0 && (
                  <span class="text-mist/70" aria-hidden="true">
                    ·
                  </span>
                )}
                <a href={link.href} class="transition-colors hover:text-accent">
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
      <span class="hidden h-5 w-5 grid-cols-3 gap-[3px] sm:grid" aria-hidden="true">
        {
          Array.from({ length: 9 }).map(() => (
            <span class="block h-[3px] w-[3px] rounded-[0.5px] bg-snow/70" />
          ))
        }
      </span>
    </div>
  </div>
</header>
