---
const links = [
  { href: '#about', label: 'About' },
  { href: '#work', label: 'Projects' },
  { href: '#contact', label: 'Contact' },
];
---

<header class="fixed inset-x-0 top-0 z-40 bg-gradient-to-b from-void via-void/85 to-transparent">
  <div
    class="mx-auto flex max-w-[1400px] items-center justify-between gap-8 px-5 py-6 sm:px-8 lg:px-12"
  >
    <a
      href="/"
      class="group inline-flex items-center text-snow"
      aria-current="page"
      aria-label="Allan Montilla home"
    >
      <img
        src="/logo-ia-mark.png"
        alt=""
        width="1014"
        height="744"
        class="h-8 w-auto max-w-none object-contain object-left sm:h-9"
        decoding="async"
      />
      <span class="sr-only">Allan Montilla</span>
    </a>

    <nav aria-label="Primary">
      <ul
        class="flex items-center gap-1 text-xs font-medium uppercase tracking-[0.2em] text-snow-muted sm:gap-2 sm:text-[13px]"
      >
        {
          links.map((link, i) => (
            <li class="flex items-center gap-1 sm:gap-2">
              {i > 0 && (
                <span class="text-mist/70" aria-hidden="true">
                  ·
                </span>
              )}
              <a href={link.href} class="transition-colors hover:text-accent">
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>
