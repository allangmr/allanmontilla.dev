---
const links = [
  { href: '#about', label: 'About' },
  { href: '#work', label: 'Projects' },
  { href: '#contact', label: 'Contact' },
];
---

<header id="site-header" class="site-header" data-scrolled="false">
  <div class="site-header__inner">
    <a
      href="/"
      class="site-header__logo"
      aria-current="page"
      aria-label="Allan Montilla home"
    >
      <img
        src="/logo-ia-header.png"
        alt=""
        width="986"
        height="716"
        decoding="async"
      />
      <span class="sr-only">Allan Montilla</span>
    </a>

    <div class="site-header__right">
      <nav aria-label="Primary">
        <ul class="site-header__nav">
          {
            links.map((link, i) => (
              <li>
                {i > 0 && (
                  <span class="site-header__dot" aria-hidden="true">
                    ·
                  </span>
                )}
                <a href={link.href}>{link.label}</a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="site-header__grid" aria-hidden="true">
        {
          Array.from({ length: 9 }).map(() => (
            <span />
          ))
        }
      </div>
    </div>
  </div>
</header>

<script is:inline>
  (() => {
    const header = document.getElementById('site-header');
    if (!header) return;
    const sync = () => {
      header.dataset.scrolled = window.scrollY > 12 ? 'true' : 'false';
    };
    sync();
    window.addEventListener('scroll', sync, { passive: true });
  })();
</script>
