---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const title = Astro.props.title ?? 'Allan Montilla · Web Developer & Software Engineer';
const description =
  Astro.props.description ??
  'Senior Frontend Engineer in Panama at Huge, building LMS and product UIs with TypeScript, React, and Next.js, open to remote US/EU.';
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL('/og.svg', Astro.site).href;
const siteUrl = Astro.site?.href ?? 'https://allanmontilla.dev/';
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      '@id': `${siteUrl}#person`,
      name: 'Allan Montilla',
      url: siteUrl,
      email: 'allangmr10@gmail.com',
      jobTitle: 'Senior Frontend Engineer',
      homeLocation: {
        '@type': 'Place',
        address: {
          '@type': 'PostalAddress',
          addressCountry: 'Panama',
        },
      },
      sameAs: [
        'https://github.com/allangmr',
        'https://www.linkedin.com/in/allan-montilla-00a756b3',
        'https://x.com/allan_coding',
      ],
    },
    {
      '@type': 'WebSite',
      '@id': `${siteUrl}#website`,
      name: 'Allan Montilla',
      url: siteUrl,
      author: { '@id': `${siteUrl}#person` },
    },
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="author" content="Allan Montilla" />
    <meta name="robots" content="index, follow" />
    <meta name="theme-color" content="#0F1821" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="Allan Montilla" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/svg+xml" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@allan_coding" />
    <meta name="twitter:creator" content="@allan_coding" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />

    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Caveat:wght@500;600&family=DM+Sans:ital,opsz,wght@0,9..40,400;0,9..40,500;0,9..40,600;0,9..40,700;1,9..40,400&family=Syne:wght@700;800&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="min-h-screen antialiased">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-md focus:bg-void-elevated focus:px-4 focus:py-2 focus:text-sm focus:font-medium focus:text-snow focus:shadow-sm"
    >
      Skip to content
    </a>
    <slot />
  </body>
</html>
